# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
# Get your Telegram Bot Token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ==============================================================================
# Instagram Authentication (Optional, Recommended for Stories & Rate-limits)
# ==============================================================================
# NOTE: Stories REQUIRE authentication per Instagram's API design.
# You can provide your browser session cookie OR username/password.

# Option 1: Session Cookies from browser (Most reliable, avoids 2FA issues)
# In your browser, open instagram.com -> DevTools (F12) -> Application -> Cookies
INSTAGRAM_SESSION_ID=
INSTAGRAM_CSRF_TOKEN=
INSTAGRAM_DS_USER_ID=

# Option 2: Pre-exported Instaloader session file path
INSTAGRAM_SESSION_FILE=

# Option 3: Direct login credentials (Instaloader will log in & save session)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# ==============================================================================
# Bot Limits & Rate Control
# ==============================================================================
# Default number of posts to download when requested without an explicit count
DEFAULT_POSTS_LIMIT=3

# Maximum posts allowed per download command (prevents bot flood & IP bans)
MAX_POSTS_LIMIT=10

# Per-user cooldown in seconds between heavy download requests
USER_COOLDOWN_SECONDS=4

# Maximum concurrent background download jobs
MAX_CONCURRENT_DOWNLOADS=3

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==============================================================================
# Google Gemini AI Configuration
# ==============================================================================
# Get your free Gemini API Key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
